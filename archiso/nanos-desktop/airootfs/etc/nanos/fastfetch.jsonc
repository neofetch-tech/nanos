{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/etc/nanos/nanos-ascii.txt",
    "padding": { "right": 2 }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "shell",
    "cpu",
    "memory",
    "disk",
    {
      "type": "custom",
      "format": "Run 'nanctl status' for live RAM/CPU"
    }
  ]
}
